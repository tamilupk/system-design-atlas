{
  "name": "system-design-atlas",
  "version": "1.0.0",
  "description": "Interactive, decision-driven system design curriculum and architecture simulator for senior engineers.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "system-design",
    "distributed-systems",
    "software-architecture",
    "faang",
    "interview-prep",
    "interactive-learning",
    "react",
    "typescript"
  ],
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build && vite-node scripts/prerender-cli.ts",
    "prerender": "vite-node scripts/prerender-cli.ts",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:build": "vitest run --config vitest.build.config.ts"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.1",
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.27.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.3.5",
    "vite-node": "^3.2.4",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
